<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    build\Shimakaze.Sdk.targets 入口（重定向）。
    本文件仅把 NuGet 风格的 PackageReference 导入重定向到真正的核心 targets：
      Sdk\Core\Shimakaze.Sdk.targets
    实际逻辑（空编译目标、模块 targets 导入等）全部落在 Sdk\ 下按功能模块拆分的文件中。
  -->

  <Import Project="$(MSBuildThisFileDirectory)..\Sdk\Sdk.targets" />

</Project>
