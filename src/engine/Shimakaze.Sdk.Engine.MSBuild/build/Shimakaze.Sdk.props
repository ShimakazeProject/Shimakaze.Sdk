<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    build\Shimakaze.Sdk.props 入口（重定向）。
    本文件仅把 NuGet 风格的 PackageReference 导入重定向到真正的核心 props：
      Sdk\Core\Shimakaze.Sdk.props
    实际逻辑（纯打包默认属性、模块 props 导入等）全部落在 Sdk\ 下按功能模块拆分的文件中。
  -->

  <Import Project="$(MSBuildThisFileDirectory)..\Sdk\Sdk.props" />

</Project>
