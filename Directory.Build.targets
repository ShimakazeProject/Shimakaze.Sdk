<Project>

  <Import Project="$(MSBuildThisFileDirectory)src\Shimakaze.Sdk.Shared\Shimakaze.Sdk.Shared.props" Condition=" '$(IsInherit)' != 'True' " />

  <PropertyGroup Condition=" '$(PackAsTool)' == 'true' ">
    <TargetFrameworks>$(ToolTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(IsRoslynComponent)' == 'true' ">
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsAotCompatible>False</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup Condition=" '$(IsRoslynComponent)' == 'true' ">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(IconPath)" Link="logo.png" Condition=" '$(IconPath)' != '' " Pack="True" PackagePath="\" />
    <None Include="$(ReadmeFile)" Link="ReadMe.md" Condition=" '$(ReadmeFile)' != '' " Pack="True" PackagePath="\" />
  </ItemGroup>

</Project>