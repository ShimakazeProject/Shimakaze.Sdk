<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import Project="$(MSBuildThisFileDirectory)Shimakaze.Sdk.Csf.props" />

  <UsingTask TaskName="CsfCompiler"
    AssemblyFile="$(ShimakazeSdkTasksDir)\Shimakaze.Sdk.Engine.MSBuild.dll"
    Condition="'$(ShimakazeSdkTasksDir)' != ''" />

  <UsingTask TaskName="CsfMerger"
    AssemblyFile="$(ShimakazeSdkTasksDir)\Shimakaze.Sdk.Engine.MSBuild.dll"
    Condition="'$(ShimakazeSdkTasksDir)' != ''" />

  <Target Name="CsfBuild"
    BeforeTargets="CoreCompile"
    Condition="'$(CsfCompile)' == 'true' AND '@(CsfResource)' != ''"
    Inputs="@(CsfResource)"
    Outputs="@(_CsfCompiledResource)">

    <CsfCompiler
      Sources="@(CsfResource)"
      OutputPath="$(CsfIntermediateOutputPath)">
      <Output TaskParameter="OutputFiles" ItemName="_CsfCompiledResource" />
    </CsfCompiler>
  </Target>

  <Target Name="CsfMerge"
    AfterTargets="CsfBuild"
    BeforeTargets="CoreCompile"
    Condition="'@(_CsfCompiledResource)' != '' AND '@(CsfResourceDestination)' != ''"
    Inputs="@(_CsfCompiledResource)"
    Outputs="@(CsfResourceDestination)">

    <CsfMerger
      Sources="@(_CsfCompiledResource)"
      Destinations="@(CsfResourceDestination)"
      OutputPath="$(CsfOutputPath)">
      <Output TaskParameter="OutputFiles" ItemName="CsfCompiledResource" />
    </CsfMerger>

    <ItemGroup>
      <Content Include="@(CsfCompiledResource)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>