<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <CsfCompile Condition="'$(CsfCompile)' == ''">true</CsfCompile>
    <ImportDefaultCsfItems Condition="'$(ImportDefaultCsfItems)' == ''">true</ImportDefaultCsfItems>
    <OutputCsfFileName Condition="'$(OutputCsfFileName)' == ''">ra2md.csf</OutputCsfFileName>
    <OutputCsfFormat Condition="'$(OutputCsfFormat)' == ''">Csf</OutputCsfFormat>
    <CsfOutputPath Condition="'$(CsfOutputPath)' == ''">$(OutputPath)</CsfOutputPath>
    <CsfIntermediateOutputPath Condition="'$(CsfIntermediateOutputPath)' == ''">$(IntermediateOutputPath)csf\</CsfIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(ImportDefaultCsfItems)' == 'true'">
    <CsfResource Include="**\*.csf" Format="Csf" Destination="$(OutputCsfFileName)" />
    <CsfResource Include="**\*.yaml" Format="Yaml" Destination="$(OutputCsfFileName)" />
    <CsfResource Include="**\*.yml" Format="Yaml" Destination="$(OutputCsfFileName)" />
    <CsfResource Include="**\*.xml" Format="Xml" Destination="$(OutputCsfFileName)" />
    <CsfResource Include="**\*.v1.json" Format="JsonV1" Destination="$(OutputCsfFileName)" />
    <CsfResource Include="**\*.v2.json" Format="JsonV2" Destination="$(OutputCsfFileName)" />
    <CsfResource Include="**\*.json" Format="JsonV2" Destination="$(OutputCsfFileName)" />
  </ItemGroup>

  <ItemGroup Condition="'$(ImportDefaultCsfItems)' == 'true'">
    <CsfResourceDestination Include="$(OutputCsfFileName)" Format="$(OutputCsfFormat)" />
  </ItemGroup>

</Project>