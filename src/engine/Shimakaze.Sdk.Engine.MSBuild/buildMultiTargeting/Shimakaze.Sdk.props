<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    buildMultiTargeting 的 props 入口（重定向）。
    本文件仅重定向到核心 props：Sdk\Core\Shimakaze.Sdk.props，
    用于多目标（multi-targeting）项目中以 PackageReference 方式引用该包时自动导入。
  -->

  <Import Project="$(MSBuildThisFileDirectory)..\Sdk\Sdk.props" />

</Project>
