<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    Shimakaze.Sdk.Tasks.targets

    当前版本仅支持 .NET 10+ 的 MSBuild 宿主。
    任务程序集位于：
      tasks\net10.0\

    不再根据 MSBuildRuntimeType / Environment.Version 判断，
    因为目标运行时已经固定。
  -->

  <PropertyGroup Condition="'$(ShimakazeSdkTasksDir)' == ''">
    <ShimakazeSdkTasksDir>$(MSBuildThisFileDirectory)..\tasks\net10.0</ShimakazeSdkTasksDir>
  </PropertyGroup>

</Project>