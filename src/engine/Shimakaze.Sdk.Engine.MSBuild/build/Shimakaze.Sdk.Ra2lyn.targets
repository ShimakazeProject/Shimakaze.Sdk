<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    Shimakaze.Sdk.Ra2lyn 模块的 targets（Ra2lyn INI 编译）。
    本文件在 Shimakaze.Sdk.targets 中被导入，负责：
      1. 声明默认的 RuleGroup 映射与 Ra2lyn 输入收集（见 Shimakaze.Sdk.Ra2lyn.props）；
      2. 定义 Ra2lynCompile 目标：按规则组调用 Shimakaze.Sdk CLI 的 cnc… Ra2lyn 子命令编译 INI。
    编译本身只通过 CLI 门面（--ra2lyn build）完成，本 targets 不直接依赖任何 MSBuild 任务类。
  -->

  <!--
    默认 RuleGroup → 输出文件名映射。
    每个 Ra2lynRuleGroup 对应一组输出（如 rule → rulesmd.ini），使用方项目可追加或 Remove 覆盖。
  -->
  <ItemGroup Condition="'$(UseDefaultRuleGroup)' == 'true'">
    <Ra2lynRuleGroup Include="ai" OutputFileName="aimd.ini" />
    <Ra2lynRuleGroup Include="art" OutputFileName="artmd.ini" />
    <Ra2lynRuleGroup Include="eva" OutputFileName="evamd.ini" />
    <Ra2lynRuleGroup Include="rule" OutputFileName="rulesmd.ini" />
    <Ra2lynRuleGroup Include="sound" OutputFileName="soundmd.ini" />
    <Ra2lynRuleGroup Include="theme" OutputFileName="thememd.ini" />
    <Ra2lynRuleGroup Include="ui" OutputFileName="uimd.ini" />
  </ItemGroup>

  <!--
    默认 Ra2lyn 输出目录：复用使用方最终设置的 $(OutputPath)。
    .targets 在使用方项目主体之后导入，此处求值的 OutputPath 已是用户覆盖后的值；
    若用户显式设置 Ra2lynOutputDirectory 则保持不变。
  -->
  <PropertyGroup>
    <Ra2lynOutputDirectory Condition="'$(Ra2lynOutputDirectory)' == ''">$(OutputPath)</Ra2lynOutputDirectory>
  </PropertyGroup>

  <!--
    默认 Ra2lyn 输入收集：递归项目目录下所有指定扩展名的文件，并按扩展名归入对应 RuleGroup。
  -->
  <ItemGroup Condition="'$(UseDefaultInclude)' == 'true'">
    <Ra2lyn Include="$(MSBuildProjectDirectory)\**\*.ai" RuleGroup="ai" />
    <Ra2lyn Include="$(MSBuildProjectDirectory)\**\*.art" RuleGroup="art" />
    <Ra2lyn Include="$(MSBuildProjectDirectory)\**\*.eva" RuleGroup="eva" />
    <Ra2lyn Include="$(MSBuildProjectDirectory)\**\*.rule" RuleGroup="rule" />
    <Ra2lyn Include="$(MSBuildProjectDirectory)\**\*.sound" RuleGroup="sound" />
    <Ra2lyn Include="$(MSBuildProjectDirectory)\**\*.theme" RuleGroup="theme" />
    <Ra2lyn Include="$(MSBuildProjectDirectory)\**\*.ui" RuleGroup="ui" />
  </ItemGroup>

  <!--
    编译：按规则组调用 CLI 的 Ra2lyn 子命令。
    - Ra2lynBuildCommand 可在使用方项目中覆盖为自定义的 CLI 调用（例如已安装到全局的工具）；
    - 默认使用随 SDK 分发的 Shimakaze.Sdk.Engine.Cli 程序集。
    CLI 的 build 子命令会按扩展名或 --group 指定组名解析，并以 {组名}.ini 输出到目录。
  -->
  <PropertyGroup>
    <Ra2lynBuildCommand Condition="'$(Ra2lynBuildCommand)' == ''">"$(ShimakazeSdkTasksDir)\Shimakaze.Sdk.Engine.Cli.exe"</Ra2lynBuildCommand>
  </PropertyGroup>

  <Target Name="Ra2lynCompile"
    BeforeTargets="CoreCompile"
    Condition="'$(Ra2lynCompile)' == 'true' AND '@(Ra2lyn)' != ''">

    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="Ra2lynBuildGroup"
      BuildInParallel="false"
      Properties="Ra2lynCurrentGroup=%(Ra2lyn.RuleGroup);Ra2lynCurrentFiles=@(Ra2lyn)" />

  </Target>

  <!--
    单组编译：由 Ra2lynCompile 以 %(Ra2lyn.RuleGroup) 逐个调用；
    输出文件名由 Ra2lynRuleGroup 的 OutputFileName 决定，缺省为 {组名}.ini。
  -->
  <Target Name="Ra2lynBuildGroup" Condition="'$(Ra2lynCurrentGroup)' != ''">
    <PropertyGroup>
      <_Ra2lynGroupOutputName></_Ra2lynGroupOutputName>
      <_Ra2lynGroupOutputName Condition="'@(Ra2lynRuleGroup->WithMetadataValue('Identity', '$(Ra2lynCurrentGroup)')->First()' != ''">@(Ra2lynRuleGroup->WithMetadataValue('Identity', '$(Ra2lynCurrentGroup)')->First()->OutputFileName())</_Ra2lynGroupOutputName>
      <_Ra2lynGroupOutputName Condition="'$(_Ra2lynGroupOutputName)' == ''">$(Ra2lynCurrentGroup).ini</_Ra2lynGroupOutputName>
    </PropertyGroup>

    <Exec
      Command="$(Ra2lynBuildCommand) ra2lyn build --input @(Ra2lyn->WithMetadataValue('RuleGroup', '$(Ra2lynCurrentGroup)')->ToString()) --output &quot;$(Ra2lynOutputDirectory)&quot; --group $(Ra2lynCurrentGroup) @(Ra2lynRuleFile->'--rules &quot;%(FullPath)&quot;')"
      ConsoleToMsBuild="true"
      IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_Ra2lynConsoleOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_Ra2lynExitCode" />
    </Exec>

    <Error Condition="'$(_Ra2lynExitCode)' != '0'" Text="Ra2lyn 编译失败：$(_Ra2lynConsoleOutput)" />
  </Target>

</Project>